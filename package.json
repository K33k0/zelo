{
  "name": "zelo-challenges",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "start": "node scripts/serve.js",
    "format": "prettier --write \"app/src/**/*.{js,java,css,html}\" \"tests/**/*.{js,java}\" \"scripts/*.js\" \"*.{js,json,md}\" \"docs/*.md\"",
    "format:check": "prettier --check \"app/src/**/*.{js,java,css,html}\" \"tests/**/*.{js,java}\" \"scripts/*.js\" \"*.{js,json,md}\" \"docs/*.md\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "3.10.1",
    "prettier-plugin-java": "2.11.0"
  }
}
